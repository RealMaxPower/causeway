# Anthropic API (tutor backend)
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-haiku-4-5
TUTOR_DAILY_BUDGET_USD=5
# Dev-only knob: where to append per-call cost records as JSONL.
# Leave blank on Vercel — the filesystem is read-only, so prod relies
# on the stdout "[tutor.cost]" log line and the in-memory budget gate
# instead. Local dev unset = data/tutor-cost.jsonl (handy for `cat`).
# "off" disables file writes everywhere (used in tests).
# Absolute path overrides — only useful on self-hosted VMs with disk.
TUTOR_COST_LOGFILE=
# Comma-separated list of allowed Origin header values for /api/tutor.
# When set, browser requests from any other origin are rejected with 403.
# Leave blank in dev. Example: https://causeway.example.com,https://www.causeway.example.com
TUTOR_ALLOWED_ORIGINS=

# Upstash Redis for per-IP rate limiting on /api/tutor (10/min, 200/day).
# When both are set, requests beyond the limit get 429 + Retry-After.
# Leave blank in dev — the in-memory daily budget still applies.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site URL — used by metadataBase, robots.txt, and sitemap.xml.
# On Vercel, leave blank: VERCEL_URL is auto-injected per deployment.
# Override once a custom domain is wired up. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Analytics: Vercel Analytics is wired via <Analytics /> in app/layout.tsx
# and auto-enabled when deployed on Vercel. No env var required. Enable
# it in the Vercel project's Analytics tab to start collecting.

# Data sources (optional — many are unauthenticated)
FRED_API_KEY=
